# ==============================================================================
# VerifyIt Portal — Environment Configuration Template
# Copy this file to '.env' and fill in your keys.
# ==============================================================================

# 1. OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Google Gemini API Key (100% FREE for Text & Image Fact-Checking)
# Get it in 30 seconds at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Telegram Bot Token (Optional - For mobile chat assistant)
# Create a bot for free in 1 minute using @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 4. Authorized Telegram User IDs (Optional - comma separated, or leave blank to allow all)
AUTHORIZED_TELEGRAM_USER_IDS=

# 5. Database URL (Optional - leave blank to use automatic local SQLite database)
# On Render / Supabase / Neon: postgresql://user:password@host:port/database
DATABASE_URL=

# 6. Google Cloud Credentials JSON (Optional - for Google Cloud TTS Telugu voice)
GOOGLE_CREDENTIALS_JSON=
